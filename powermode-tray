#!/usr/bin/env python3
# Иконка в трее для /usr/local/bin/powermode: Eco / Max. Нужны gir1.2-ayatanaappindicator3-0.1 и расширение ubuntu-appindicators (оба уже есть).
import os
import subprocess
# Если запущено из терминала VS Code (snap), туда протекают переменные snap и GTK падает
# (symbol lookup error ... core20/libpthread). Сбрасываем их до импорта GTK.
for _v in ("GTK_PATH", "GTK_EXE_PREFIX", "GIO_MODULE_DIR", "GTK_IM_MODULE_FILE",
           "GDK_PIXBUF_MODULE_FILE", "GTK_MODULES", "LD_LIBRARY_PATH", "LD_PRELOAD"):
    os.environ.pop(_v, None)
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("AyatanaAppIndicator3", "0.1")
from gi.repository import Gtk, GLib, AyatanaAppIndicator3 as AI

ICONS = {"eco": "power-profile-power-saver-symbolic", "max": "power-profile-performance-symbolic",
         "ultra": "dialog-warning-symbolic"}
LABELS = {"eco": "Eco: CPU 45/55 Вт, GPU ≤1500 МГц", "max": "Max: CPU 70/115 Вт, GPU без лимита",
          "ultra": "Ultra: без лимитов (CPU 215 Вт, GPU без лимита)"}


def mode():
    try:
        return open("/etc/powermode").read().strip()
    except OSError:
        return "?"


def set_mode(_item, m):
    # без пароля, если настроен sudoers (см. инструкцию), иначе окно запроса пароля
    if subprocess.run(["sudo", "-n", "/usr/local/bin/powermode", m], capture_output=True).returncode:
        subprocess.run(["pkexec", "/usr/local/bin/powermode", m])
    refresh()


def refresh():
    m = mode()
    ind.set_icon_full(ICONS.get(m, "dialog-question-symbolic"), m)
    status.set_label(LABELS.get(m, "режим не задан"))
    return True


ind = AI.Indicator.new("powermode", ICONS["eco"], AI.IndicatorCategory.HARDWARE)
ind.set_status(AI.IndicatorStatus.ACTIVE)
menu = Gtk.Menu()
status = Gtk.MenuItem(label="…")
status.set_sensitive(False)
menu.append(status)
menu.append(Gtk.SeparatorMenuItem())
for m, text in (("eco", "Eco (безопасный)"), ("max", "Max (заводской пик)"), ("ultra", "Ultra (без лимитов)")):
    it = Gtk.MenuItem(label=text)
    it.connect("activate", set_mode, m)
    menu.append(it)
menu.show_all()
ind.set_menu(menu)
refresh()
GLib.timeout_add_seconds(10, refresh)
Gtk.main()
